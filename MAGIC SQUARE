#include <stdio.h>
#include <string.h>

void magicsquare(int n) {
    int magic[50][50];
    memset(magic, 0, sizeof(magic));
    
    int i = n / 2;
    int j = n - 1;

    for (int num = 1; num <= n * n; ) {
        if (i == -1 && j == n) {
            j = n - 2;
            i = 0;
        } else {
            if (j == n) j = 0;
            if (i < 0) i = n - 1;
        }

        if (magic[i][j] != 0) {
            j -= 2;
            i++;
            continue;
        } else {
            magic[i][j] = num++;
        }

        i--;
        j++;
    } // <-- Closed the placement loop BEFORE printing!

    // Print the grid once after the loop finishes
    for (int r = 0; r < n; r++) {
        for (int c = 0; c < n; c++) {
            printf("%3d ", magic[r][c]); // Added space for clean alignment
        }
        printf("\n"); // Fixed: backslash \n instead of /n
    }
} // <-- Closed magicsquare() BEFORE main() starts!

int main() {
    int n;
    printf("Enter the value of n: ");
    scanf("%d", &n);
    magicsquare(n);
    return 0;
}
